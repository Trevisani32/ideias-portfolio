{
  "name": "ideias-portfolio",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "prestart": "node scripts/gerar-conteudo.mjs --com-rascunhos",
    "start": "ng serve",
    "prebuild": "node scripts/gerar-conteudo.mjs",
    "build": "ng build",
    "postbuild": "node scripts/copiar-404.mjs",
    "test": "ng test",
    "test:conteudo": "node --test scripts/gerar-conteudo.test.mjs",
    "conteudo": "node scripts/gerar-conteudo.mjs --com-rascunhos",
